# Copy this file to .env.local and fill in your values

# Privy App ID — get one at https://console.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# WalletConnect Project ID — get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# VeChain network: "main" or "test"
NEXT_PUBLIC_VECHAIN_NETWORK=main

# GitHub Pages base path (set to /my-vechain-dapp for gh-pages deploy)
# NEXT_PUBLIC_BASE_PATH=/my-vechain-dapp
